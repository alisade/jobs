PR #418 "Send the access token to the API, not the ID token" (security review item SR-77)

--- a/src/config/auth.ts
+++ b/src/config/auth.ts
@@ -12,9 +12,11 @@ export async function authHeader(): Promise<Record<string, string>> {
   const session = await fetchAuthSession();
-  // Pilot: the API reads custom:tenant_id, which only the ID token carries.
-  const token = session.tokens?.idToken?.toString();
