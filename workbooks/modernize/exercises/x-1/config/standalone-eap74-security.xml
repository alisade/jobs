<!-- EAP 7.4 production (cdk-app-01..04): the legacy security subsystem ClaimDesk logs in through. -->
<subsystem xmlns="urn:jboss:domain:security:2.0">
  <security-domains>
    <security-domain name="claimdesk-ldap" cache-type="default">
      <authentication>
        <login-module code="LdapExtended" flag="required">
          <module-option name="java.naming.provider.url" value="ldaps://ldap-vip.corvane.local:636"/>
          <module-option name="bindDN" value="uid=svc-claimdesk,ou=service,dc=corvane,dc=local"/>
          <module-option name="bindCredential" value="${VAULT::claimdesk::ldapBind::1}"/>
          <module-option name="baseCtxDN" value="ou=people,dc=corvane,dc=local"/>
          <module-option name="baseFilter" value="(uid={0})"/>
          <module-option name="rolesCtxDN" value="ou=groups,dc=corvane,dc=local"/>
          <module-option name="roleFilter" value="(member={1})"/>
          <module-option name="roleAttributeID" value="cn"/>
          <module-option name="roleRecursion" value="2"/>
          <module-option name="searchScope" value="SUBTREE_SCOPE"/>
        </login-module>
      </authentication>
      <mapping>
        <mapping-module code="PropertiesRoles" type="role">
          <module-option name="rolesProperties" value="file:${jboss.server.config.dir}/claimdesk-roles.properties"/>
        </mapping-module>
      </mapping>
    </security-domain>
  </security-domains>
</subsystem>
