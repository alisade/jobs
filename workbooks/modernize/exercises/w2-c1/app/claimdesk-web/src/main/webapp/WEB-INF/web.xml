<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
  <display-name>ClaimDesk</display-name>

  <listener>
    <listener-class>com.corvane.claimdesk.web.StartupListener</listener-class>
  </listener>

  <servlet>
    <servlet-name>claims</servlet-name>
    <servlet-class>com.corvane.claimdesk.web.ClaimServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>claims</servlet-name>
    <url-pattern>/claims/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>payments</servlet-name>
    <servlet-class>com.corvane.claimdesk.web.PaymentServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>payments</servlet-name>
    <url-pattern>/payments/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>admin</servlet-name>
    <servlet-class>com.corvane.claimdesk.web.AdminServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>admin</servlet-name>
    <url-pattern>/admin/*</url-pattern>
  </servlet-mapping>

  <filter>
    <filter-name>ldapGroup</filter-name>
    <filter-class>com.corvane.claimdesk.web.LdapGroupFilter</filter-class>
    <init-param>
      <param-name>requiredGroup</param-name>
      <param-value>cn=claims-payments,ou=groups,dc=corvane,dc=local</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>ldapGroup</filter-name>
    <url-pattern>/payments/*</url-pattern>
  </filter-mapping>

  <security-constraint>
    <web-resource-collection>
      <web-resource-name>admin</web-resource-name>
      <url-pattern>/admin/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>CLAIMS_ADMIN</role-name>
    </auth-constraint>
  </security-constraint>
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>everything</web-resource-name>
      <url-pattern>/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>CLAIMS_USER</role-name>
    </auth-constraint>
  </security-constraint>

  <login-config>
    <auth-method>FORM</auth-method>
    <realm-name>ClaimDesk</realm-name>
    <form-login-config>
      <form-login-page>/login.jsp</form-login-page>
      <form-error-page>/login.jsp?error=1</form-error-page>
    </form-login-config>
  </login-config>

  <security-role><role-name>CLAIMS_USER</role-name></security-role>
  <security-role><role-name>CLAIMS_ADMIN</role-name></security-role>
  <security-role><role-name>CLAIMS_SUPERVISOR</role-name></security-role>
  <security-role><role-name>AUDITOR</role-name></security-role>
</web-app>
