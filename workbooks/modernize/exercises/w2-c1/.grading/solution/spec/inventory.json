  "scheduled_jobs": [
    {
      "name": "NightlyReinsuranceExport",
      "schedule": "02:00 every day, EJB timer, non-persistent",
      "runs_in": "app-server",
      "touches": [
        "CLAIM",
        "RESERVE_LINE",
        "ADJUSTER",
        "/var/claimdesk/outbox",
        "Halberd Re SFTP"
      ],
      "evidence": [
        {
          "ref": "app/claimdesk-web/src/main/java/com/corvane/claimdesk/batch/NightlyReinsuranceExport.java:31",
          "quote": "@Schedule(hour = \"2\""
        }
      ]
    },
    {
      "name": "purge-archive.sh",
      "schedule": "Sunday 03:30 (cron, cdk-app-01 only)",
      "runs_in": "cron",
      "touches": [
        "CLMARCH.CLAIM_ARCHIVE_<YYYY>"
      ],
      "evidence": [
        {
          "ref": "app/ops/crontab:3",
          "quote": "30 3 * * 0"
        },
        {
          "ref": "app/ops/purge-archive.sh:6",
          "quote": "DELETE FROM CLMARCH"
        }
      ]
    }
  ],
  "runtime_assumptions": [
    {
      "topic": "timezone",
      "value": "America/New_York forced by -Duser.timezone",
      "risk": "SYSDATE and LocalDate.now() mix database and JVM zones",
      "evidence": [
        {
          "ref": "app/ops/standalone-claimdesk.conf:4",
          "quote": "-Duser.timezone=America/New_York"
        }
      ]
    },
    {
      "topic": "charset",
      "value": "ISO-8859-1 JVM default, JSP and bordereau",
      "risk": "JDK 18+ defaults to UTF-8 (JEP 400)",
      "evidence": [
        {
          "ref": "app/ops/standalone-claimdesk.conf:5",
          "quote": "-Dfile.encoding=ISO-8859-1"
