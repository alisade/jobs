  "integrations": [
    {
      "name": "Corporate LDAP (group check for payments)",
      "protocol": "ldap",
      "direction": "outbound",
      "status": "live",
      "endpoint_source": "ldap.url in /etc/claimdesk/claimdesk.properties",
      "failure_behaviour": "NamingException returns false: payments are denied (fail closed)",
      "evidence": [
        {
          "ref": "app/claimdesk-web/src/main/java/com/corvane/claimdesk/web/LdapGroupFilter.java:43",
          "quote": "Context.PROVIDER_URL"
        },
        {
          "ref": "app/config/claimdesk.properties:2",
          "quote": "ldap.url=ldaps://ldap-vip.corvane.local:636"
        }
      ]
    },
    {
      "name": "Sentinel fraud scoring (SIU)",
      "protocol": "http",
      "direction": "outbound",
      "status": "live",
      "endpoint_source": "JNDI java:global/claimdesk/fraudScoreUrl, bound in the jboss-cli build script",
      "failure_behaviour": "any IOException returns score 0: fails open",
      "evidence": [
        {
          "ref": "app/claimdesk-web/src/main/java/com/corvane/claimdesk/integration/FraudClient.java:18",
