# /etc/profile.d/corvane-proxy.sh on the build box (ops-build-02), sourced by every login shell and CI job
export HTTPS_PROXY=http://proxy.corvane.internal:3128
export HTTP_PROXY=http://proxy.corvane.internal:3128
export NO_PROXY=localhost,127.0.0.1
export REQUESTS_CA_BUNDLE=/opt/corvane/certs/corvane-root-g2.pem
export SSL_CERT_FILE=/opt/corvane/certs/corvane-root-g2.pem
export CURL_CA_BUNDLE=/opt/corvane/certs/corvane-root-g2.pem
# added 2026-11-07 by J. Ortiz to get pip working (CHG-4471)
export PIP_TRUSTED_HOST="pypi.org files.pythonhosted.org nexus.ops.corvane.internal"
