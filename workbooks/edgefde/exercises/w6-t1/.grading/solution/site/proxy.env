# /etc/profile.d/corvane-proxy.sh on the build box (ops-build-02), sourced by every login shell and CI job
export HTTPS_PROXY=http://proxy.corvane.internal:3128
export HTTP_PROXY=http://proxy.corvane.internal:3128
# internal hosts are reached directly, never through the inspecting proxy
export NO_PROXY=localhost,127.0.0.1,.corvane.internal
# one bundle for every client: public roots + Corvane Root CA G2 + both Corvane issuing CAs
export REQUESTS_CA_BUNDLE=/opt/corvane/certs/ca-bundle.pem
export SSL_CERT_FILE=/opt/corvane/certs/ca-bundle.pem
export CURL_CA_BUNDLE=/opt/corvane/certs/ca-bundle.pem
export PIP_CERT=/opt/corvane/certs/ca-bundle.pem
# CHG-4471 PIP_TRUSTED_HOST workaround removed (verification must stay on)
