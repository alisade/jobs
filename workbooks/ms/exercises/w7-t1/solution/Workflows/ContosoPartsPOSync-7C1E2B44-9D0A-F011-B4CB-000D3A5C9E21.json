                ]
              },
              "inputs": "@body('List_PO_lines')?['value']"
            },
            "Send_to_Contoso_Parts": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Compose_payload": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_contoso-20parts-5f3f9c2a716b1e4d8a",
                  "operationId": "SubmitPurchaseOrder",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_contoso-20parts-5f3f9c2a716b1e4d8a"
                },
                "parameters": {
                  "api-version": "2026-09-01",
                  "body/poNumber": "@triggerOutputs()?['body/contoso_ponumber']",
                  "body/supplierCode": "@triggerOutputs()?['body/contoso_suppliercode']",
                  "body/lines": "@outputs('Compose_payload')"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              }
            },
            "Mark_PO_as_sent": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Send_to_Contoso_Parts": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "contoso_purchaseorders",
                  "recordId": "@triggerOutputs()?['body/contoso_purchaseorderid']",
                  "item/contoso_partsreference": "@body('Send_to_Contoso_Parts')?['orderReference']",
                  "item/contoso_syncstatus": 100000001
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        },
        "Catch": {
          "type": "Scope",
          "runAfter": {
            "Try": [
              "Failed"
            ]
          },
          "actions": {
            "Compose_failure_details": {
              "type": "Compose",
              "runAfter": {},
              "inputs": "@result('Try')"
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
