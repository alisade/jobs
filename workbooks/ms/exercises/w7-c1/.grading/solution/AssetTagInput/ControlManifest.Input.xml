<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Tailspin" constructor="AssetTagInput" version="0.1.0"
           display-name-key="Asset tag input" description-key="Validated Tailspin asset tag entry"
           control-type="standard">
    <external-service-usage enabled="false"></external-service-usage>
    <!-- The column this control is bound to on the form. -->
    <property name="assetTag" display-name-key="Asset tag" description-key="Asset tag column"
              of-type="SingleLine.Text" usage="bound" required="true" />
    <!-- Configuration set by the maker when the control is added to a form. -->
    <property name="tagPrefix" display-name-key="Tag prefix" description-key="Site prefix, e.g. TSP"
              of-type="SingleLine.Text" usage="input" required="false" />
    <property name="debounceMs" display-name-key="Debounce (ms)" description-key="Delay before a typed value is committed"
              of-type="Whole.None" usage="input" required="false" />
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/AssetTagInput.css" order="1" />
    </resources>
  </control>
</manifest>
