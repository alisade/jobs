{
  "locals": {
    "ci_project": "tsl-platform-ci",
    "ci_project_number": "417203958311",
    "pool_id": "github",
    "repo": "tessellate/platform-foundation"
  },
  "resource": {
    "google_iam_workload_identity_pool": {
      "github": {
        "project": "${local.ci_project}",
        "workload_identity_pool_id": "${local.pool_id}",
        "display_name": "GitHub Actions",
        "description": "Federation for tessellate GitHub Actions"
      }
    },
    "google_iam_workload_identity_pool_provider": {
      "github": {
        "project": "${local.ci_project}",
        "project_number": "${local.ci_project_number}",
        "workload_identity_pool_id": "${local.pool_id}",
        "workload_identity_pool_provider_id": "github-actions",
        "display_name": "GitHub Actions OIDC",
        "attribute_mapping": {
          "google.subject": "assertion.sub",
          "attribute.repository": "assertion.repository",
          "attribute.repository_owner": "assertion.repository_owner",
          "attribute.ref": "assertion.ref"
        },
        "attribute_condition": "assertion.repository_owner == 'tessellate'",
        "oidc": [
          {
            "issuer_uri": "https://token.actions.githubusercontent.com"
          }
        ]
      }
    },
    "google_service_account": {
      "tf_plan": {
        "project": "${local.ci_project}",
        "account_id": "tf-plan",
        "display_name": "Terraform plan (read-only, PRs)"
      },
      "tf_apply": {
        "project": "${local.ci_project}",
        "account_id": "tf-apply",
        "display_name": "Terraform apply (production)"
      }
    },
    "google_service_account_iam_member": {
      "plan_wif": {
        "service_account_id": "projects/${local.ci_project}/serviceAccounts/tf-plan@${local.ci_project}.iam.gserviceaccount.com",
        "role": "roles/iam.workloadIdentityUser",
        "member": "principalSet://iam.googleapis.com/projects/${local.ci_project_number}/locations/global/workloadIdentityPools/${local.pool_id}/attribute.repository/${local.repo}"
      },
      "apply_wif": {
        "service_account_id": "projects/${local.ci_project}/serviceAccounts/tf-apply@${local.ci_project}.iam.gserviceaccount.com",
        "role": "roles/iam.workloadIdentityUser",
        "member": "principal://iam.googleapis.com/projects/${local.ci_project_number}/locations/global/workloadIdentityPools/${local.pool_id}/subject/repo:${local.repo}:ref:refs/heads/main"
      },
      "apply_token_creator": {
        "service_account_id": "projects/${local.ci_project}/serviceAccounts/tf-apply@${local.ci_project}.iam.gserviceaccount.com",
        "role": "roles/iam.serviceAccountTokenCreator",
        "member": "group:gcp-platform-admins@tessellate.example"
      }
    }
  }
}
