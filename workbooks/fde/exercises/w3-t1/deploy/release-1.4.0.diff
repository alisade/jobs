Author: Priya Raman <priya.raman@northwind.example>
Date:   Thu Oct 2 16:12:44 2026 +0000

    release northwind-trust 1.4.0 (storefront-host)

    - SRE-412: make every trust default explicit in trust.env so the ConfigMap is the
      single source of truth (no hidden code defaults during audits)
    - SRE-398: open the risk breaker after 5 consecutive failures instead of 10
    - bump anthropic 0.121.0 -> 0.122.0, httpx 0.27.2 -> 0.28.1
    - decision log: add the "policy" field

diff --git a/deploy/trust.env b/deploy/trust.env
index 3f0c1aa..8d2e941 100644
--- a/deploy/trust.env
+++ b/deploy/trust.env
@@ -1,18 +1,20 @@
 # northwind-trust settings for storefront-host (prod-us-east-1).
 # Rendered into ConfigMap storefront-host-trust by the release pipeline.
 # Owner: trust-platform. Change ticket required for TRUST_CHECKOUT_*.
 
 RISK_API_BASE_URL=https://risk.halyard.example/v2
 RISK_API_CLIENT_ID=northwind-storefront-prod
 
 # Cart writes: cheap to undo, keep shopping alive if the risk API is sick.
 TRUST_CART_TIMEOUT_MS=150
 TRUST_CART_FAIL_OPEN=true
 
-# Checkout: money moves next. Fails closed (code default).
+# Checkout: money moves next. Never proceed without a decision.
 TRUST_CHECKOUT_TIMEOUT_MS=400
+TRUST_CHECKOUT_FAIL_OPEN=false
 
-TRUST_BREAKER_FAILURES=10
+TRUST_BREAKER_FAILURES=5
 TRUST_BREAKER_RESET_S=30
 
 LOG_LEVEL=INFO
 DECISION_LOG_SINK=stdout-json
