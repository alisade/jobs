# northwind-trust settings for storefront-host (prod-us-east-1).
# Rendered into ConfigMap storefront-host-trust by the release pipeline.
# Owner: trust-platform. Change ticket required for TRUST_CHECKOUT_*.

RISK_API_BASE_URL=https://risk.halyard.example/v2
RISK_API_CLIENT_ID=northwind-storefront-prod

# Cart writes: cheap to undo, keep shopping alive if the risk API is sick.
TRUST_CART_TIMEOUT_MS=150
TRUST_CART_FAIL_OPEN=true

# Checkout: money moves next. Never proceed without a decision.
TRUST_CHECKOUT_TIMEOUT_MS=400
TRUST_CHECKOUT_FAIL_OPEN=false

TRUST_BREAKER_FAILURES=5
TRUST_BREAKER_RESET_S=30

LOG_LEVEL=INFO
DECISION_LOG_SINK=stdout-json
