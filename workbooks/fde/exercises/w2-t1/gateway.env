# edge-mcp-gateway runtime config (deployed by the platform team, change ticket PLAT-2291)
# Values here are read at startup; a real environment variable of the same name wins.

IDP_ISSUER=http://127.0.0.1:18210/
IDP_JWKS_URL=http://127.0.0.1:18210/.well-known/jwks.json
GATEWAY_AUDIENCE=https://mcp.northwind.example/mcp
UPSTREAM_MCP_URL=http://127.0.0.1:18212/mcp

# JWKS key cache. Keys are cached for JWKS_CACHE_TTL seconds. A token whose kid is not in
# the cache triggers a refresh, rate limited to one per JWKS_MIN_REFRESH_INTERVAL seconds
# (security: random kids must not let callers hammer the IdP; SEC-114 asks for at most
# one forced refresh per 10 s).
JWKS_CACHE_TTL=86400
JWKS_MIN_REFRESH_INTERVAL=86400

# Accepted clock skew between the IdP and the gateway, in seconds.
CLOCK_LEEWAY=30
