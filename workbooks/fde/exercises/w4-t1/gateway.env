# Larkspur Home - storefront gateway (local reproduction of prod config)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18410
# Shared HMAC secret for the signed customer claim the Managed Agents vault credential carries.
GATEWAY_SECRET=larkspur-local-dev-secret-not-for-prod
# Simulated Redis round trip for the rate limiter and the session store (prod p50 ~12 ms).
REDIS_LATENCY_MS=12
# Raised from 60 in release 2026.10.07 (see incident/CHANGELOG.txt).
SESSION_CACHE_TTL_S=900
