{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyPipelinesChangeIam",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:TagRole"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/cdk-hnb659fds-cfn-exec-role-*",
            "arn:aws:iam::*:role/hpm-breakglass"
          ]
        }
      }
    }
  ]
}