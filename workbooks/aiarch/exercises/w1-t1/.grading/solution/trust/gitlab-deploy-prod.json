{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitLabReleaseTagDeploy",
      "Effect": "Allow",
      "Principal": {"Federated": "arn:aws:iam::111100000004:oidc-provider/gitlab.com"},
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {"gitlab.com:aud": "https://gitlab.com"},
        "StringLike": {"gitlab.com:sub": "project_path:harborpoint/lighthouse/platform:ref_type:tag:ref:v*"}
      }
    }
  ]
}
