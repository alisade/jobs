{
  "Version": "2019-10-30",
  "StartAction": "set-recording",
  "Metadata": {
    "name": "mod-recording-defaults",
    "description": "Recording and analytics defaults applied before every queue transfer (v3, 2026-03-11, LFG-1302 PCI redaction)"
  },
  "Actions": [
    {
      "Identifier": "set-recording",
      "Type": "UpdateContactRecordingAndAnalyticsBehavior",
      "Parameters": {
        "VoiceBehavior": {
          "VoiceRecordingBehavior": {
            "RecordedParticipants": [
              "Agent",
              "Customer"
            ],
            "IVRRecordingBehavior": "Disabled"
          },
          "VoiceAnalyticsBehavior": {
            "Enabled": "True",
            "AnalyticsLanguage": "en-US",
            "AnalyticsModes": [
              "PostContact"
            ],
            "ConversationalAnalyticsRedactionConfiguration": {
              "Enabled": "True",
              "RedactionResults": "RedactedOnly",
              "RedactionMaskMode": "PII",
              "RedactionEntities": [
                "CREDIT_DEBIT_NUMBER",
                "NAME",
                "USERNAME",
                "PASSWORD",
                "PHONE",
                "EMAIL",
                "SSN"
              ]
            },
            "SentimentConfiguration": {
              "Enabled": "True"
            },
            "SummaryConfiguration": {
              "SummaryModes": [
                "PostContact"
              ]
            }
          }
        }
      },
      "Transitions": {
        "NextAction": "done",
        "Errors": [
          {
            "NextAction": "done",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "done",
            "ErrorType": "ChannelMismatch"
          }
        ]
      }
    },
    {
      "Identifier": "done",
      "Type": "EndFlowModuleExecution",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}