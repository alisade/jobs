              }
            ]
          }
        },
        {
          "Identifier": "major-priority",
          "Type": "UpdateContactRoutingBehavior",
          "Parameters": {
            "QueuePriority": "1"
          },
          "Transitions": {
            "NextAction": "transfer",
            "Errors": [
              {
                "NextAction": "transfer",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "fallback-general",
          "Type": "UpdateContactTargetQueue",
          "Parameters": {
            "QueueId": "arn:aws:connect:us-east-1:444455556666:instance/9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d/queue/895a5686-23de-4486-8c33-72e59acf001a"
          },
          "Transitions": {
            "NextAction": "transfer",
            "Errors": [
              {
                "NextAction": "disconnect",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "transfer",
          "Type": "TransferContactToQueue",
          "Parameters": {},
          "Transitions": {
            "Errors": [
              {
                "NextAction": "disconnect",
                "ErrorType": "QueueAtCapacity"
              },
              {
                "NextAction": "disconnect",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "disconnect",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    }
  },
  "modules": {
    "mod-after-hours": {
      "Version": "2019-10-30",
      "StartAction": "closed-msg",
      "Actions": [
        {
          "Identifier": "closed-msg",
          "Type": "MessageParticipant",
          "Parameters": {
            "PromptId": "arn:aws:connect:us-east-1:444455556666:instance/9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d/prompt/47a260bc-7e58-41d2-8ef2-3b2299720ccc"
          },
          "Transitions": {
            "NextAction": "return",
            "Errors": [
              {
                "NextAction": "return",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "return",
          "Type": "EndFlowModuleExecution",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "mod-password-reset": {
      "Version": "2019-10-30",
      "StartAction": "reset-lambda",
      "Actions": [
        {
          "Identifier": "reset-lambda",
          "Type": "InvokeLambdaFunction",
          "Parameters": {
            "LambdaFunctionARN": "arn:aws:lambda:us-east-1:444455556666:function:lfg-password-reset:live",
            "InvocationTimeLimitSeconds": "6",
            "InvocationType": "SYNCHRONOUS",
            "LambdaInvocationAttributes": {
              "employeeId": "$.Attributes.employeeId",
              "fallbackQueueArn": "arn:aws:connect:us-east-1:444455556666:instance/9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d/queue/1f16d8c5-06d8-4f45-8de4-7942d8aaa860",
              "audit": "{\"source\":\"ivr\",\"instance\":\"arn:aws:connect:us-east-1:444455556666:instance/9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d\"}"
            },
            "ResponseValidation": {
              "ResponseType": "STRING_MAP"
            }
          },
          "Transitions": {
            "NextAction": "save-status",
            "Errors": [
              {
                "NextAction": "save-failed",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "save-status",
          "Type": "UpdateContactAttributes",
          "Parameters": {
            "Attributes": {
              "resetStatus": "$.External.resetStatus"
            },
            "TargetContact": "Current"
          },
          "Transitions": {
            "NextAction": "confirm",
            "Errors": [
              {
                "NextAction": "save-failed",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "confirm",
          "Type": "Compare",
          "Parameters": {
            "ComparisonValue": "$.Attributes.resetStatus"
          },
          "Transitions": {
            "Conditions": [
              {
                "NextAction": "sent-msg",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "SENT"
                  ]
                }
              }
            ],
            "Errors": [
              {
                "NextAction": "return",
                "ErrorType": "NoMatchingCondition"
              }
            ]
          }
        },
        {
          "Identifier": "sent-msg",
          "Type": "MessageParticipant",
          "Parameters": {
            "Text": "A reset link has been sent to the mobile number on your employee record."
          },
          "Transitions": {
            "NextAction": "return",
            "Errors": [
              {
                "NextAction": "return",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "save-failed",
          "Type": "UpdateContactAttributes",
          "Parameters": {
            "Attributes": {
              "resetStatus": "FAILED"
            },
            "TargetContact": "Current"
          },
          "Transitions": {
            "NextAction": "return",
            "Errors": [
              {
                "NextAction": "return",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "return",
          "Type": "EndFlowModuleExecution",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    }
  }
}