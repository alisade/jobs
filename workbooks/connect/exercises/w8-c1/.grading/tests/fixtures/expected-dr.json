{
  "flows": {
    "LFG Help Desk Inbound": {
      "Version": "2019-10-30",
      "StartAction": "start-logging",
      "Metadata": {
        "entryPointPosition": {
          "x": 40,
          "y": 40
        },
        "ActionMetadata": {
          "set-q-vip": {
            "position": {
              "x": 900,
              "y": 120
            },
            "parameters": {
              "QueueId": {
                "displayName": "VIPDesk"
              }
            },
            "queue": {
              "id": "arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b/queue/85300fcc-5d7e-4b3c-8fff-cdfbc7714c51",
              "text": "VIPDesk"
            }
          },
          "ask-bot": {
            "position": {
              "x": 600,
              "y": 300
            },
            "parameters": {
              "LexV2Bot": {
                "AliasArn": {
                  "displayName": "live",
                  "useLexBotDropdown": true,
                  "lexV2BotName": "HelpDeskBot"
                }
              }
            }
          },
          "password-module": {
            "position": {
              "x": 900,
              "y": 300
            },
            "parameters": {
              "FlowModuleId": {
                "displayName": "mod-password-reset"
              }
            }
          }
        }
      },
      "Actions": [
        {
          "Identifier": "start-logging",
          "Type": "UpdateFlowLoggingBehavior",
          "Parameters": {
            "FlowLoggingBehavior": "Enabled"
          },
          "Transitions": {
            "NextAction": "check-hours"
          }
        },
        {
          "Identifier": "check-hours",
          "Type": "CheckHoursOfOperation",
          "Parameters": {
            "HoursOfOperationId": "arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b/operating-hours/d024282c-885e-4cbf-8c63-d4fcfa61e893"
          },
          "Transitions": {
            "Conditions": [
              {
                "NextAction": "identify-caller",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "True"
                  ]
                }
              },
              {
                "NextAction": "after-hours",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "False"
                  ]
                }
              }
            ],
            "Errors": [
              {
                "NextAction": "identify-caller",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "after-hours",
          "Type": "InvokeFlowModule",
          "Parameters": {
            "FlowModuleId": "968972eb-b31c-4b1f-8683-18a1eb7fe054"
          },
          "Transitions": {
            "NextAction": "disconnect",
            "Errors": [
              {
                "NextAction": "disconnect",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "identify-caller",
          "Type": "InvokeLambdaFunction",
          "Parameters": {
            "LambdaFunctionARN": "arn:aws:lambda:us-west-2:444455556666:function:lfg-identify-caller:live",
            "InvocationTimeLimitSeconds": "3",
            "InvocationType": "SYNCHRONOUS",
            "LambdaInvocationAttributes": {
              "instanceArn": "arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b",
              "callbackQueueId": "c8a66750-949f-4668-86dc-81e2ed966ff8"
            },
            "ResponseValidation": {
              "ResponseType": "STRING_MAP"
            }
          },
          "Transitions": {
            "NextAction": "set-verified",
            "Errors": [
              {
                "NextAction": "set-unverified",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "set-verified",
          "Type": "UpdateContactAttributes",
          "Parameters": {
            "Attributes": {
              "employeeId": "$.External.employeeId",
              "vip": "$.External.vip",
              "callerVerified": "true"
            },
            "TargetContact": "Current"
          },
          "Transitions": {
            "NextAction": "check-vip",
            "Errors": [
              {
                "NextAction": "set-unverified",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "set-unverified",
          "Type": "UpdateContactAttributes",
          "Parameters": {
            "Attributes": {
              "employeeId": "",
              "vip": "false",
              "callerVerified": "false"
            },
            "TargetContact": "Current"
          },
          "Transitions": {
            "NextAction": "check-vip",
            "Errors": [
              {
                "NextAction": "set-q-general",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "check-vip",
          "Type": "Compare",
          "Parameters": {
            "ComparisonValue": "$.Attributes.vip"
          },
          "Transitions": {
            "Conditions": [
              {
                "NextAction": "set-q-vip",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "true"
                  ]
                }
              }
            ],
            "Errors": [
              {
                "NextAction": "ask-bot",
                "ErrorType": "NoMatchingCondition"
              }
            ]
          }
        },
        {
          "Identifier": "set-q-vip",
          "Type": "UpdateContactTargetQueue",
          "Parameters": {
            "QueueId": "arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b/queue/85300fcc-5d7e-4b3c-8fff-cdfbc7714c51"
          },
          "Transitions": {
            "NextAction": "vip-priority",
            "Errors": [
              {
                "NextAction": "set-q-general",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "vip-priority",
          "Type": "UpdateContactRoutingBehavior",
          "Parameters": {
            "QueuePriority": "1"
          },
          "Transitions": {
            "NextAction": "transfer",
            "Errors": [
              {
                "NextAction": "transfer",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "ask-bot",
          "Type": "ConnectParticipantWithLexBot",
          "Parameters": {
            "Text": "In a few words, tell me what you need help with.",
            "LexV2Bot": {
              "AliasArn": "arn:aws:lex:us-west-2:444455556666:bot-alias/FFDJFEBBED/ECJJHHFJDF"
            },
            "LexSessionAttributes": {
              "callerVerified": "$.Attributes.callerVerified"
            }
          },
          "Transitions": {
            "Conditions": [
              {
                "NextAction": "password-module",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "ResetPassword"
                  ]
                }
              },
              {
                "NextAction": "to-major-incident",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "ReportOutage"
                  ]
                }
              },
              {
                "NextAction": "set-q-general",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "GeneralIssue"
                  ]
                }
              }
            ],
            "Errors": [
              {
                "NextAction": "set-q-general",
                "ErrorType": "InputTimeLimitExceeded"
              },
              {
                "NextAction": "set-q-general",
                "ErrorType": "NoMatchingCondition"
              },
              {
                "NextAction": "set-q-general",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "password-module",
          "Type": "InvokeFlowModule",
          "Parameters": {
            "FlowModuleId": "2c8911fa-fd3e-4030-83bb-7158e6c292cf"
          },
          "Transitions": {
            "NextAction": "reset-done",
            "Errors": [
              {
                "NextAction": "set-q-password",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "reset-done",
          "Type": "Compare",
          "Parameters": {
            "ComparisonValue": "$.Attributes.resetStatus"
          },
          "Transitions": {
            "Conditions": [
              {
                "NextAction": "disconnect",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "SENT"
                  ]
                }
              }
            ],
            "Errors": [
              {
                "NextAction": "set-q-password",
                "ErrorType": "NoMatchingCondition"
              }
            ]
          }
        },
        {
          "Identifier": "to-major-incident",
          "Type": "TransferToFlow",
          "Parameters": {
            "ContactFlowId": "arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b/contact-flow/95abb524-29d5-4d04-8808-0d5c761b33e4"
          },
          "Transitions": {
            "Errors": [
              {
                "NextAction": "set-q-general",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "set-q-password",
          "Type": "UpdateContactTargetQueue",
          "Parameters": {
            "QueueId": "arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b/queue/23f2ff8c-b066-43e5-837f-99fd3586af84"
          },
          "Transitions": {
            "NextAction": "transfer",
            "Errors": [
              {
                "NextAction": "set-q-general",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "set-q-general",
          "Type": "UpdateContactTargetQueue",
          "Parameters": {
            "QueueId": "arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b/queue/f25bac1d-177d-46c8-8e9b-d922f62c9d73"
          },
          "Transitions": {
            "NextAction": "transfer",
            "Errors": [
              {
                "NextAction": "tech-msg",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "transfer",
          "Type": "TransferContactToQueue",
          "Parameters": {},
          "Transitions": {
            "Errors": [
              {
                "NextAction": "tech-msg",
                "ErrorType": "QueueAtCapacity"
              },
              {
                "NextAction": "tech-msg",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "tech-msg",
          "Type": "MessageParticipant",
          "Parameters": {
            "Text": "We are experiencing technical difficulties. Please open a ticket in the employee portal. Goodbye."
          },
          "Transitions": {
            "NextAction": "disconnect",
            "Errors": [
              {
                "NextAction": "disconnect",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "disconnect",
          "Type": "DisconnectParticipant",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "LFG Major Incident": {
