        }
      ]
    }
  },
  "modules": {
    "mod-after-hours": {
      "Version": "2019-10-30",
      "StartAction": "closed-msg",
      "Actions": [
        {
          "Identifier": "closed-msg",
          "Type": "MessageParticipant",
          "Parameters": {
            "PromptId": "arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b/prompt/1c9870ac-88fb-402e-8c56-8addf2ff93fc"
          },
          "Transitions": {
            "NextAction": "return",
            "Errors": [
              {
                "NextAction": "return",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "return",
          "Type": "EndFlowModuleExecution",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    },
    "mod-password-reset": {
      "Version": "2019-10-30",
      "StartAction": "reset-lambda",
      "Actions": [
        {
          "Identifier": "reset-lambda",
          "Type": "InvokeLambdaFunction",
          "Parameters": {
            "LambdaFunctionARN": "arn:aws:lambda:us-west-2:444455556666:function:lfg-password-reset:live",
            "InvocationTimeLimitSeconds": "6",
            "InvocationType": "SYNCHRONOUS",
            "LambdaInvocationAttributes": {
              "employeeId": "$.Attributes.employeeId",
              "fallbackQueueArn": "arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b/queue/23f2ff8c-b066-43e5-837f-99fd3586af84",
              "audit": "{\"source\":\"ivr\",\"instance\":\"arn:aws:connect:us-west-2:444455556666:instance/0e1f2a3b-4c5d-4e6f-8a7b-9c0d1e2f3a4b\"}"
            },
            "ResponseValidation": {
              "ResponseType": "STRING_MAP"
            }
          },
          "Transitions": {
            "NextAction": "save-status",
            "Errors": [
              {
                "NextAction": "save-failed",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "save-status",
          "Type": "UpdateContactAttributes",
          "Parameters": {
            "Attributes": {
              "resetStatus": "$.External.resetStatus"
            },
            "TargetContact": "Current"
          },
          "Transitions": {
            "NextAction": "confirm",
            "Errors": [
              {
                "NextAction": "save-failed",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "confirm",
          "Type": "Compare",
          "Parameters": {
            "ComparisonValue": "$.Attributes.resetStatus"
          },
          "Transitions": {
            "Conditions": [
              {
                "NextAction": "sent-msg",
                "Condition": {
                  "Operator": "Equals",
                  "Operands": [
                    "SENT"
                  ]
                }
              }
            ],
            "Errors": [
              {
                "NextAction": "return",
                "ErrorType": "NoMatchingCondition"
              }
            ]
          }
        },
        {
          "Identifier": "sent-msg",
          "Type": "MessageParticipant",
          "Parameters": {
            "Text": "A reset link has been sent to the mobile number on your employee record."
          },
          "Transitions": {
            "NextAction": "return",
            "Errors": [
              {
                "NextAction": "return",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "save-failed",
          "Type": "UpdateContactAttributes",
          "Parameters": {
            "Attributes": {
              "resetStatus": "FAILED"
            },
            "TargetContact": "Current"
          },
          "Transitions": {
            "NextAction": "return",
            "Errors": [
              {
                "NextAction": "return",
                "ErrorType": "NoMatchingError"
              }
            ]
          }
        },
        {
          "Identifier": "return",
          "Type": "EndFlowModuleExecution",
          "Parameters": {},
          "Transitions": {}
        }
      ]
    }
  }
