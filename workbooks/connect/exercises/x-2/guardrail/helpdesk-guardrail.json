{
  "name": "lfg-helpdesk-selfservice",
  "description": "Guardrail for the Larkspur help desk self-service assistant (chat + voice). Version 3: added after pen-test PT-2026-17.",
  "topicPolicyConfig": {
    "topicsConfig": [
      {
        "name": "Credentials and account access",
        "definition": "Any request about passwords, credentials, logins, MFA, account unlocks or account access.",
        "examples": [
          "my password",
          "log in to my account",
          "unlock my account",
          "reset password",
          "account credentials"
        ],
        "type": "DENY",
        "inputEnabled": true,
        "inputAction": "BLOCK",
        "outputEnabled": true,
        "outputAction": "BLOCK"
      },
      {
        "name": "Investment advice",
        "definition": "Recommendations about buying or selling securities, funds or other investments.",
        "examples": [
          "should I buy Larkspur stock",
          "which fund should I put my bonus in"
        ],
        "type": "DENY",
        "inputEnabled": true,
        "inputAction": "BLOCK",
        "outputEnabled": true,
        "outputAction": "BLOCK"
      }
    ]
  },
  "contentPolicyConfig": {
    "filtersConfig": [
      {
        "type": "PROMPT_ATTACK",
        "inputStrength": "HIGH",
        "outputStrength": "NONE"
      },
      {
        "type": "MISCONDUCT",
        "inputStrength": "MEDIUM",
        "outputStrength": "MEDIUM"
      },
      {
        "type": "INSULTS",
        "inputStrength": "LOW",
        "outputStrength": "MEDIUM"
      }
    ]
  },
  "wordPolicyConfig": {
    "wordsConfig": [
      {
        "text": "mimikatz"
      },
      {
        "text": "pass the hash"
      }
    ],
    "managedWordListsConfig": [
      {
        "type": "PROFANITY"
      }
    ]
  },
  "sensitiveInformationPolicyConfig": {
    "piiEntitiesConfig": [
      {
        "type": "PASSWORD",
        "action": "BLOCK",
        "inputAction": "BLOCK",
        "outputAction": "BLOCK"
      },
      {
        "type": "USERNAME",
        "action": "ANONYMIZE",
        "inputAction": "NONE",
        "outputAction": "ANONYMIZE"
      },
      {
        "type": "EMAIL",
        "action": "ANONYMIZE",
        "inputAction": "NONE",
        "outputAction": "ANONYMIZE"
      },
      {
        "type": "PHONE",
        "action": "ANONYMIZE",
        "inputAction": "NONE",
        "outputAction": "ANONYMIZE"
      }
    ]
  },
  "blockedInputMessaging": "I can't help with that here. Let me connect you with the help desk.",
  "blockedOutputsMessaging": "I can't share that. Let me connect you with the help desk."
