{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRedactedAnalysisOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::lfg-connect-us-east-1",
      "Condition": { "StringLike": { "s3:prefix": ["connect/lfg-helpdesk/Analysis/Voice/Redacted/*"] } }
    },
    {
      "Sid": "ReadRedactedAnalysisOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::lfg-connect-us-east-1/connect/lfg-helpdesk/Analysis/Voice/Redacted/*"
    },
    {
      "Sid": "WriteReports",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::lfg-qa-reports/qa-insights/*"
    }
  ]
}
